# Configurações do banco de dados
# Este arquivo serve apenas como modelo
# Cada integrante deve utilizar suas próprias credenciais no arquivo ".env"

# Pelo amor de Deus. Não coloquem credenciais reais nesse arquivo!

DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
JWT_SECRET=
# Origem do frontend quando estiver em outra porta, por exemplo http://localhost:3000
FRONTEND_ORIGIN=
